# Server-only — these power the serverless proxy (api/*.ts), never shipped
# to the browser. Run `npm run spotify:auth` to fill both in automatically.
SPOTIFY_CLIENT_ID=
SPOTIFY_REFRESH_TOKEN=

# Powers the "Ask your library" AI feature (api/ask-library.ts). Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
